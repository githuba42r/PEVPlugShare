<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black"
    tools:context=".ui.edit.ImageEditorActivity">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:padding="12dp"
        android:gravity="center_vertical">
        
        <TextView
            android:id="@+id/instructionTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Image"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Image Canvas -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/black">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Image to edit" />

        <ImageView
            android:id="@+id/resetZoomIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:src="@drawable/ic_zoom_out"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:visibility="gone"
            android:contentDescription="Reset Zoom" />
    </FrameLayout>

    <!-- Main Control Buttons -->
            <GridLayout
                android:id="@+id/mainControlsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface"
                android:padding="8dp"
                android:columnCount="5"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">
    
                <!-- Rotate Left -->
                <include
                    android:id="@+id/rotateLeftButton"
                    layout="@layout/layout_icon_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />
    
                <!-- Rotate Right -->
                <include
                    android:id="@+id/rotateRightButton"
                    layout="@layout/layout_icon_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />
    
                <!-- Focus -->
                <include
                    android:id="@+id/focusButton"
                    layout="@layout/layout_icon_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />
    
                <!-- Crop -->
                <include
                    android:id="@+id/cropButton"
                    layout="@layout/layout_icon_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />
    
                <!-- Reset -->
                <include
                    android:id="@+id/resetButton"
                    layout="@layout/layout_icon_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />
    
                <!-- Save -->
                <include
                    android:id="@+id/saveButton"
                    layout="@layout/layout_icon_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />
    
                <!-- Save New -->
                <include
                    android:id="@+id/saveNewButton"
                    layout="@layout/layout_icon_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />
    
                <!-- Cancel -->
                <include
                    android:id="@+id/cancelButton"
                    layout="@layout/layout_icon_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1" />
    
            </GridLayout>
    <!-- Crop Sub-menu Controls -->
    <LinearLayout
        android:id="@+id/cropControlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="?attr/colorSurface"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Crop Cancel -->
        <include
            android:id="@+id/cropCancelButton"
            layout="@layout/layout_icon_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Crop Reset -->
        <include
            android:id="@+id/cropResetButton"
            layout="@layout/layout_icon_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Crop Apply -->
        <include
            android:id="@+id/cropApplyButton"
            layout="@layout/layout_icon_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Focus Sub-menu Controls -->
    <LinearLayout
        android:id="@+id/focusControlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="?attr/colorSurface"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Focus Cancel -->
        <include
            android:id="@+id/focusCancelButton"
            layout="@layout/layout_icon_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Focus Reset -->
        <include
            android:id="@+id/focusResetButton"
            layout="@layout/layout_icon_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Focus Apply -->
        <include
            android:id="@+id/focusApplyButton"
            layout="@layout/layout_icon_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>
