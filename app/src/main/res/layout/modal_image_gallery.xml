<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/imageGalleryOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DD000000"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true">

    <!-- Top header with close button -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/galleryToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_clear"
        app:title="Location Photos"
        app:titleTextColor="@android:color/white" />

    <!-- Location description -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/actionBarSize"
        android:layout_marginBottom="130dp"
        android:maxHeight="80dp">

        <TextView
            android:id="@+id/locationDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Location description here"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:background="#66000000" />
    </ScrollView>

    <!-- ViewPager for swiping -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/imageViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="120dp"
        android:layout_marginBottom="80dp" />

    <!-- Bottom controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#AA000000">

        <TextView
            android:id="@+id/imageCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="1 / 5"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

                            <LinearLayout
                                android:id="@+id/thumbnailContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="60dp"
                                android:orientation="horizontal"
                                android:gravity="center" />
            
                            <Button
                                android:id="@+id/addMoreImagesButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Add More Images"
                                android:layout_marginStart="8dp"
                                app:icon="@drawable/ic_add"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />        </HorizontalScrollView>
    </LinearLayout>

</FrameLayout>
