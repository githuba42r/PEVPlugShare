<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filter Locations"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

    <!-- Free/Charge Filter -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cost"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:flexWrap="wrap"
        app:justifyContent="flex_start">

        <TextView
            android:id="@+id/costFree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@drawable/socket_badge_background"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:text="Free"
            android:textColor="@color/socket_badge_text_color"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/costPaid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@drawable/socket_badge_background"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:text="Paid"
            android:textColor="@color/socket_badge_text_color"
            android:textSize="14sp" />
    </com.google.android.flexbox.FlexboxLayout>

    <!-- Opening Hours Filter -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Opening Hours"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <CheckBox
        android:id="@+id/openNowCheckbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Now Only" />

    <!-- Number of Sockets Filter -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Number of Sockets"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/minSocketsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Min: 0"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.slider.RangeSlider
            android:id="@+id/socketsRangeSlider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="0"
            android:valueTo="10"
            android:stepSize="1"
            app:values="@array/default_socket_range" />

        <TextView
            android:id="@+id/maxSocketsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Max: 10+"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Public/Private Filter -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Access Type"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:flexWrap="wrap"
        app:justifyContent="flex_start">

        <TextView
            android:id="@+id/accessPublic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@drawable/socket_badge_background"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:text="Public"
            android:textColor="@color/socket_badge_text_color"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/accessPrivate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@drawable/socket_badge_background"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:text="Private"
            android:textColor="@color/socket_badge_text_color"
            android:textSize="14sp" />
    </com.google.android.flexbox.FlexboxLayout>

    <!-- Socket Types Filter -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Socket Types"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:flexWrap="wrap"
        app:alignItems="flex_start"
        app:alignContent="flex_start"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/socketAS3112"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AS3112 (AU GPO)"
            android:background="@drawable/socket_badge_background"
            android:textColor="@color/socket_badge_text_color"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/socketType2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type2 EV"
            android:background="@drawable/socket_badge_background"
            android:textColor="@color/socket_badge_text_color"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/socketTesla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tesla"
            android:background="@drawable/socket_badge_background"
            android:textColor="@color/socket_badge_text_color"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/socketCCS2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CCS2/Combo"
            android:background="@drawable/socket_badge_background"
            android:textColor="@color/socket_badge_text_color"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/socketCHAdeMO"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHAdeMO"
            android:background="@drawable/socket_badge_background"
            android:textColor="@color/socket_badge_text_color"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/socketType1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type 1 (J1772)"
            android:background="@drawable/socket_badge_background"
            android:textColor="@color/socket_badge_text_color"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/socketWallSocket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wall Socket (15A)"
            android:background="@drawable/socket_badge_background"
            android:textColor="@color/socket_badge_text_color"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/socketCaravan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caravan Plug"
            android:background="@drawable/socket_badge_background"
            android:textColor="@color/socket_badge_text_color"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/socketOther"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Other EV"
            android:background="@drawable/socket_badge_background"
            android:textColor="@color/socket_badge_text_color"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            android:textSize="12sp" />

    </com.google.android.flexbox.FlexboxLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:backgroundTint="@android:color/white"
            android:textColor="@color/md_theme_primary"
            app:strokeColor="@color/md_theme_primary"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:layout_marginStart="8dp"
            android:backgroundTint="@android:color/white"
            android:textColor="@color/md_theme_primary"
            app:strokeColor="@color/md_theme_primary"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/applyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    </LinearLayout>

</ScrollView>
