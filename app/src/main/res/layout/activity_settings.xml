<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        app:navigationIcon="@drawable/ic_back"
        app:title="Settings"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- API Key Entry Section (shown when no key) -->
        <LinearLayout
            android:id="@+id/apiKeyEntrySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Label and description for OpenRouter.AI API Key -->
            <TextView
                android:id="@+id/apiKeyLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OpenRouter.AI Integration"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/apiKeyDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connect your OpenRouter account to enable AI-powered image analysis and description generation for charging locations."
                android:textSize="14sp"
                android:textColor="?android:textColorSecondary"
                android:paddingBottom="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/getApiKeyButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connect OpenRouter Account"
                android:textSize="16sp"
                android:paddingVertical="16dp"
                style="@style/Widget.MaterialComponents.Button" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="You'll be redirected to OpenRouter.ai to authorize this app. No manual API key entry required."
                android:textSize="12sp"
                android:textColor="?android:textColorSecondary"
                android:gravity="center"
                android:alpha="0.8" />
        </LinearLayout>

        <!-- API Key Valid Section (shown when key is valid) -->
        <LinearLayout
            android:id="@+id/apiKeyValidSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- AI Model Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="OpenRouter.ai Model"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetApiKeyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disconnect"
                    android:textSize="12sp"
                    android:contentDescription="Disconnect OpenRouter"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/selectedModelCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardElevation="2dp"
                app:cardCornerRadius="8dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/apiKeyStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="18sp"
                        android:textColor="#4CAF50"
                        android:textStyle="bold"
                        android:paddingEnd="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/selectedModelName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tap to select a model"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="?android:textColorPrimary" />

                        <TextView
                            android:id="@+id/selectedModelProvider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="12sp"
                            android:paddingTop="2dp"
                            android:textColor="?android:textColorSecondary" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="2dp">

                            <TextView
                                android:id="@+id/selectedModelCost"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="12sp"
                                android:textColor="?android:textColorSecondary" />

                            <TextView
                                android:id="@+id/selectedModelContext"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="12sp"
                                android:paddingStart="12dp"
                                android:textColor="?android:textColorSecondary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Map Settings Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Map Settings"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Default Zoom Level"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/zoomLevelValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18.0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:minWidth="48dp"
                    android:gravity="center" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/zoomLevelSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="15.0"
                android:valueTo="20.0"
                android:value="18.0"
                android:stepSize="0.5" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="15 = Neighborhood view • 20 = Maximum detail"
                android:textSize="12sp"
                android:textColor="?android:textColorSecondary"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- OsmAnd Sync Settings Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OsmAnd Sync Settings"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchPromptOsmandSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prompt to sync when updating locations"
                android:checked="true"
                android:paddingVertical="8dp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchVerifyDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verify description before syncing"
                android:checked="true"
                android:paddingVertical="8dp" />

            <!-- Location Match Distance Setting -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Location Match Distance"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Allow matching of local locations with OsmAnd locations where the name is out of sync between the 2 data sources. GPS matching on the location will be performed to find the matching location."
                android:textSize="12sp"
                android:textColor="?android:textColorSecondary"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <com.google.android.material.slider.Slider
                    android:id="@+id/osmandMatchDistanceSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="10"
                    android:valueTo="100"
                    android:stepSize="10"
                    android:value="10" />

                <TextView
                    android:id="@+id/osmandMatchDistanceValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10m"
                    android:textSize="14sp"
                    android:minWidth="50dp"
                    android:gravity="end"
                    android:paddingStart="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="These settings control OsmAnd synchronization behavior when editing locations"
                android:textSize="12sp"
                android:textColor="?android:textColorSecondary"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/loadingProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginVertical="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:paddingVertical="8dp"
            android:gravity="center" />

        <!-- Bottom Action Buttons -->
        <LinearLayout
            android:id="@+id/bottomButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveSettingsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Save"
                style="@style/Widget.MaterialComponents.Button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reset"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

    </LinearLayout>
    </ScrollView>
</LinearLayout>
