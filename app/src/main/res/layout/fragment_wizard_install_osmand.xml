<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/installTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wizard_install_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/installDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wizard_install_description"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="24dp" />

        <!-- Detected container (green) -->
        <LinearLayout
            android:id="@+id/detectedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/wizard_success_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wizard_install_detected_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#86efac"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wizard_install_detected_message"
                android:textColor="#d1d5db"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Not found container (red) -->
        <LinearLayout
            android:id="@+id/notFoundContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/wizard_error_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wizard_install_not_found_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#fca5a5"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wizard_install_not_found_message"
                android:textColor="#d1d5db"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/playStoreFreeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wizard_install_play_free"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/playStorePlusButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wizard_install_play_plus" />

        </LinearLayout>

        <Button
            android:id="@+id/recheckButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wizard_install_recheck"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/installedCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wizard_install_checkbox"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/nextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wizard_install_next"
            android:enabled="false" />

    </LinearLayout>
</ScrollView>
