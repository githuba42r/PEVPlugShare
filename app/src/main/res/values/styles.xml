<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PEVPlugShare" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorError">@color/md_theme_error</item>
    </style>

    <!-- Custom Outlined Button Style with Green Border and Square Corners -->
    <style name="CustomOutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">0dp</item>
        <item name="strokeColor">@color/md_theme_primary</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/md_theme_primary</item>
    </style>

</resources>
