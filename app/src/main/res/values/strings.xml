    <string name="wizard_connect_error">Connection failed. Please check your credentials.</string>

    <!-- Setup Wizard — Step 7: Verify Folder -->
    <string name="wizard_verify_title">Select Your Charging Folder</string>
    <string name="wizard_verify_description">PEVPlugShare found your OsmAnd folders. Select the folder you created for PEV charging locations.</string>
    <string name="wizard_verify_loading">Loading your folders…</string>
    <string name="wizard_verify_no_folders">No folders found. Please go back and make sure you created a folder and synced it to OsmAnd Cloud.</string>
