    <string name="wizard_verify_next">Use This Folder</string>
    <string name="wizard_verify_retry">Retry — Check for Folders</string>
    <string name="wizard_verify_delay_warning">Sync delay: After syncing in OsmAnd, there can be a delay of 1–2 minutes before the folder appears in the OsmAnd Cloud API. If you\'ve already created the folder and synced, please wait a moment and then tap \"Retry\" below.</string>

    <!-- Setup Wizard — Step 8: AI Features -->
    <string name="wizard_ai_title">AI-Powered Features (Optional)</string>
    <string name="wizard_ai_description">PEVPlugShare can use AI to automatically analyse photos and generate descriptions for your charging locations.</string>
    <string name="wizard_ai_how_it_works">How it works: You connect a free OpenRouter account, choose a model, and PEVPlugShare uses AI to describe locations from photos you take.</string>
