# Database backend: 'postgres' or 'mysql'
DB_BACKEND=postgres

# Full database connection URL
DATABASE_URL=postgresql://user:password@localhost:5432/pevplugshare

# Redis connection URL (optional)
REDIS_URL=redis://localhost:6379

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT signing secret (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Path to store uploaded photos
STORAGE_PATH=./data/photos

# Public base URL of this server
SERVER_BASE_URL=http://localhost:8080

# Log level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# Maximum upload size in megabytes
MAX_UPLOAD_SIZE_MB=5

# Admin email address for initial setup (optional)
ADMIN_SETUP_EMAIL=admin@example.com

# Session secret for admin browser sessions (falls back to JWT_SECRET if not set)
SESSION_SECRET=your-session-secret

# Port to listen on
PORT=8080
