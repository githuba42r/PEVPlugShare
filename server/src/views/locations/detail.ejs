<%- include('../partials/head', { title: location.name }) %>
<%- include('../partials/nav') %>

<div class="p-8 max-w-5xl">
  <div class="flex items-center gap-4 mb-6">
    <a href="/admin/locations" class="text-gray-400 hover:text-white text-sm">&larr; Locations</a>
    <h1 class="text-2xl font-bold"><%= location.name %></h1>
    <% if (location.isDeleted) { %>
      <span class="bg-red-900 text-red-200 text-xs px-2 py-1 rounded">Deleted</span>
    <% } %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
      <h2 class="text-lg font-semibold mb-4 text-gray-200">Location Details</h2>
      <dl class="space-y-3 text-sm">
        <div class="flex gap-2"><dt class="text-gray-400 w-36">ID:</dt><dd class="text-gray-200 font-mono text-xs break-all"><%= location.id %></dd></div>
        <div class="flex gap-2"><dt class="text-gray-400 w-36">Owner:</dt><dd><a href="/admin/users/<%= location.ownerId %>" class="text-blue-400 hover:text-blue-300 font-mono text-xs"><%= location.ownerId %></a></dd></div>
        <div class="flex gap-2"><dt class="text-gray-400 w-36">Coordinates:</dt><dd class="text-gray-200"><%= location.latitude %>, <%= location.longitude %></dd></div>
        <div class="flex gap-2"><dt class="text-gray-400 w-36">Visibility:</dt><dd class="text-gray-200"><%= location.publicPrivate %></dd></div>
        <div class="flex gap-2"><dt class="text-gray-400 w-36">Version:</dt><dd class="text-gray-200"><%= location.version %></dd></div>
        <div class="flex gap-2"><dt class="text-gray-400 w-36">Has Fee:</dt><dd class="text-gray-200"><%= location.hasFee ? 'Yes' : 'No' %></dd></div>
        <div class="flex gap-2"><dt class="text-gray-400 w-36">Socket Types:</dt><dd class="text-gray-200"><%= location.socketTypes.join(', ') || '—' %></dd></div>
        <div class="flex gap-2"><dt class="text-gray-400 w-36">GPO Count:</dt><dd class="text-gray-200"><%= location.gpoCount != null ? location.gpoCount : '—' %></dd></div>
        <div class="flex gap-2"><dt class="text-gray-400 w-36">Created:</dt><dd class="text-gray-200"><%= new Date(location.createdAt).toLocaleString() %></dd></div>
        <div class="flex gap-2"><dt class="text-gray-400 w-36">Updated:</dt><dd class="text-gray-200"><%= new Date(location.updatedAt).toLocaleString() %></dd></div>
      </dl>
    </div>

    <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
      <h2 class="text-lg font-semibold mb-4 text-gray-200">Address & Info</h2>
      <dl class="space-y-3 text-sm">
        <div class="flex gap-2"><dt class="text-gray-400 w-36">Street:</dt><dd class="text-gray-200"><%= location.streetAddress || '—' %></dd></div>
        <div class="flex gap-2"><dt class="text-gray-400 w-36">Suburb:</dt><dd class="text-gray-200"><%= location.suburb || '—' %></dd></div>
        <div class="flex gap-2"><dt class="text-gray-400 w-36">State:</dt><dd class="text-gray-200"><%= location.state || '—' %></dd></div>
        <div class="flex gap-2"><dt class="text-gray-400 w-36">Postcode:</dt><dd class="text-gray-200"><%= location.postcode || '—' %></dd></div>
        <div class="flex gap-2"><dt class="text-gray-400 w-36">Business:</dt><dd class="text-gray-200"><%= location.businessName || '—' %></dd></div>
        <div class="flex gap-2"><dt class="text-gray-400 w-36">Provider:</dt><dd class="text-gray-200"><%= location.providerName || '—' %></dd></div>
        <div class="flex gap-2"><dt class="text-gray-400 w-36">Description:</dt><dd class="text-gray-200 text-xs"><%= location.description || '—' %></dd></div>
        <div class="flex gap-2"><dt class="text-gray-400 w-36">Charging Costs:</dt><dd class="text-gray-200"><%= location.chargingCosts || '—' %></dd></div>
        <div class="flex gap-2"><dt class="text-gray-400 w-36">Opening Hours:</dt><dd class="text-gray-200 text-xs"><%= location.openingHours || '—' %></dd></div>
        <% if (location.isDeleted) { %>
          <div class="flex gap-2"><dt class="text-gray-400 w-36">Delete Reason:</dt><dd class="text-red-300"><%= location.deletedReason || '—' %></dd></div>
        <% } %>
      </dl>
    </div>
  </div>

  <% if (photos && photos.length > 0) { %>
    <div class="bg-gray-800 rounded-lg p-6 border border-gray-700 mb-6">
      <h2 class="text-lg font-semibold mb-4 text-gray-200">Photos (<%= photos.length %>)</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <% photos.forEach(function(photo) { %>
          <div class="relative">
            <% if (photo.thumbnailPath) { %>
              <img src="<%= photo.thumbnailPath %>" class="w-full h-32 object-cover rounded border border-gray-600" />
            <% } else { %>
              <div class="w-full h-32 bg-gray-700 rounded border border-gray-600 flex items-center justify-center text-gray-500 text-xs">No thumbnail</div>
            <% } %>
            <div class="text-gray-500 text-xs mt-1 truncate"><%= photo.id.substring(0, 12) %>...</div>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <% if (!location.isDeleted) { %>
    <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
      <h2 class="text-lg font-semibold mb-4 text-gray-200">Delete Location</h2>
      <div class="flex gap-3 items-end">
        <div>
          <label class="block text-xs text-gray-400 mb-1">Reason (optional)</label>
          <input type="text" id="deleteReason" placeholder="Reason for deletion"
            class="bg-gray-700 border border-gray-600 rounded px-3 py-2 text-sm focus:outline-none focus:border-red-500 w-72" />
        </div>
        <button onclick="deleteLocation()" class="bg-red-700 hover:bg-red-800 text-white px-4 py-2 rounded text-sm">Delete Location</button>
      </div>
      <div id="deleteStatus" class="mt-3 text-sm hidden"></div>
    </div>
  <% } %>
</div>

<script>
  const locationId = '<%= location.id %>';

  async function deleteLocation() {
    const reason = document.getElementById('deleteReason').value.trim();
    if (!confirm('Are you sure you want to delete this location?')) return;

    try {
      const res = await fetch('/admin/api/locations/' + locationId, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason: reason || undefined }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed');
      const el = document.getElementById('deleteStatus');
      el.textContent = 'Location deleted. Reloading...';
      el.className = 'mt-3 text-sm text-green-400';
      el.classList.remove('hidden');
      setTimeout(() => location.reload(), 800);
    } catch (err) {
      const el = document.getElementById('deleteStatus');
      el.textContent = err.message;
      el.className = 'mt-3 text-sm text-red-400';
      el.classList.remove('hidden');
    }
  }
</script>

<%- include('../partials/footer') %>
