<%- include('../partials/head', { title: 'Locations' }) %>
<%- include('../partials/nav') %>

<div class="p-8">
  <h1 class="text-2xl font-bold mb-6">Locations</h1>

  <div class="bg-gray-800 rounded-lg border border-gray-700 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-gray-700 text-gray-300 text-left">
          <th class="px-4 py-3">Name</th>
          <th class="px-4 py-3">Owner ID</th>
          <th class="px-4 py-3">Lat / Lon</th>
          <th class="px-4 py-3">Visibility</th>
          <th class="px-4 py-3">Deleted</th>
          <th class="px-4 py-3">Version</th>
          <th class="px-4 py-3">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (locations.length === 0) { %>
          <tr>
            <td colspan="7" class="px-4 py-6 text-center text-gray-500">No locations found.</td>
          </tr>
        <% } %>
        <% locations.forEach(function(loc) { %>
          <tr class="border-t border-gray-700 hover:bg-gray-750 <%= loc.isDeleted ? 'opacity-50' : '' %>">
            <td class="px-4 py-3 text-gray-200"><%= loc.name %></td>
            <td class="px-4 py-3 text-gray-400 font-mono text-xs">
              <a href="/admin/users/<%= loc.ownerId %>" class="text-blue-400 hover:text-blue-300"><%= loc.ownerId.substring(0, 8) %>...</a>
            </td>
            <td class="px-4 py-3 text-gray-400 text-xs"><%= loc.latitude.toFixed(4) %>, <%= loc.longitude.toFixed(4) %></td>
            <td class="px-4 py-3">
              <span class="text-xs px-2 py-1 rounded
                <% if (loc.publicPrivate === 'PUBLIC') { %>bg-green-900 text-green-200<% } else if (loc.publicPrivate === 'PRIVATE') { %>bg-gray-700 text-gray-300<% } else { %>bg-yellow-900 text-yellow-200<% } %>">
                <%= loc.publicPrivate %>
              </span>
            </td>
            <td class="px-4 py-3">
              <% if (loc.isDeleted) { %>
                <span class="bg-red-900 text-red-200 text-xs px-2 py-1 rounded">Deleted</span>
              <% } else { %>
                <span class="text-gray-600 text-xs">—</span>
              <% } %>
            </td>
            <td class="px-4 py-3 text-gray-400 text-xs"><%= loc.version %></td>
            <td class="px-4 py-3">
              <a href="/admin/locations/<%= loc.id %>" class="text-blue-400 hover:text-blue-300 text-xs">View</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex gap-4 text-sm">
    <% if (typeof nextCursor !== 'undefined' && nextCursor) { %>
      <a href="/admin/locations?cursor=<%= encodeURIComponent(nextCursor) %>"
         class="text-blue-400 hover:text-blue-300">Next Page &rarr;</a>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
