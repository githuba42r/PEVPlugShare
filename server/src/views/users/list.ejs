<%- include('../partials/head', { title: 'Users' }) %>
<%- include('../partials/nav') %>

<div class="p-8">
  <h1 class="text-2xl font-bold mb-6">Users</h1>

  <form method="GET" action="/admin/users" class="mb-6 flex gap-3">
    <input
      type="text"
      name="q"
      value="<%= typeof q !== 'undefined' ? q : '' %>"
      placeholder="Search by email or name..."
      class="bg-gray-800 border border-gray-700 rounded px-4 py-2 text-sm w-80 focus:outline-none focus:border-blue-500"
    />
    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded text-sm">Search</button>
    <% if (typeof q !== 'undefined' && q) { %>
      <a href="/admin/users" class="text-gray-400 hover:text-white px-4 py-2 rounded text-sm border border-gray-700">Clear</a>
    <% } %>
  </form>

  <div class="bg-gray-800 rounded-lg border border-gray-700 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-gray-700 text-gray-300 text-left">
          <th class="px-4 py-3">Email</th>
          <th class="px-4 py-3">Display Name</th>
          <th class="px-4 py-3">Admin</th>
          <th class="px-4 py-3">Banned</th>
          <th class="px-4 py-3">Created</th>
          <th class="px-4 py-3">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (users.length === 0) { %>
          <tr>
            <td colspan="6" class="px-4 py-6 text-center text-gray-500">No users found.</td>
          </tr>
        <% } %>
        <% users.forEach(function(user) { %>
          <tr class="border-t border-gray-700 hover:bg-gray-750">
            <td class="px-4 py-3 text-gray-200"><%= user.email %></td>
            <td class="px-4 py-3 text-gray-300"><%= user.displayName %></td>
            <td class="px-4 py-3">
              <% if (user.isAdmin) { %>
                <span class="bg-purple-900 text-purple-200 text-xs px-2 py-1 rounded">Admin</span>
              <% } else { %>
                <span class="text-gray-600 text-xs">—</span>
              <% } %>
            </td>
            <td class="px-4 py-3">
              <% if (user.isBanned) { %>
                <span class="bg-red-900 text-red-200 text-xs px-2 py-1 rounded">Banned</span>
              <% } else { %>
                <span class="text-gray-600 text-xs">—</span>
              <% } %>
            </td>
            <td class="px-4 py-3 text-gray-400 text-xs"><%= new Date(user.createdAt).toLocaleDateString() %></td>
            <td class="px-4 py-3">
              <a href="/admin/users/<%= user.id %>" class="text-blue-400 hover:text-blue-300 text-xs">View</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <% if (cursor || users.length > 0) { %>
    <div class="mt-4 flex gap-4 text-sm">
      <% if (typeof nextCursor !== 'undefined' && nextCursor) { %>
        <a href="/admin/users?<%= typeof q !== 'undefined' && q ? 'q=' + encodeURIComponent(q) + '&' : '' %>cursor=<%= encodeURIComponent(nextCursor) %>"
           class="text-blue-400 hover:text-blue-300">Next Page &rarr;</a>
      <% } %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
