<%- include('partials/head', { title: 'Login' }) %>

<div class="flex items-center justify-center min-h-screen">
  <div class="bg-gray-800 rounded-lg p-8 w-full max-w-md shadow-xl">
    <h1 class="text-2xl font-bold text-green-400 mb-2 text-center">PEVPlugShare Admin</h1>
    <p class="text-gray-400 text-center mb-8">Sign in with your Google account</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="bg-red-900 border border-red-700 text-red-200 px-4 py-3 rounded mb-6">
        <%= error %>
      </div>
    <% } %>

    <div id="g_id_onload"
      data-client_id="<%= googleClientId %>"
      data-login_uri="/admin/login"
      data-auto_prompt="false">
    </div>

    <div class="flex justify-center">
      <div class="g_id_signin"
        data-type="standard"
        data-size="large"
        data-theme="filled_black"
        data-text="sign_in_with"
        data-shape="rectangular"
        data-logo_alignment="left">
      </div>
    </div>

    <p class="text-gray-500 text-xs text-center mt-6">Access restricted to authorised administrators only.</p>
  </div>
</div>

<script src="https://accounts.google.com/gsi/client" async defer></script>

<%- include('partials/footer') %>
