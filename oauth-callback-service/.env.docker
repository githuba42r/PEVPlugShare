# Docker-specific environment file
# Copy this to .env and customize for your deployment

# Service Configuration
DOMAIN_NAME=https://your-cloudflare-tunnel.example.com
DEEP_LINK_SCHEME=pevplugshare://oauth/callback

# Database (Docker volume path)
DATABASE_URL=sqlite:////app/data/oauth_sessions.db

# Session Settings
SESSION_TTL_MINUTES=10
CLEANUP_INTERVAL_MINUTES=5

# Security - CHANGE THIS!
SHARED_SECRET=your-secret-key-here
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100
RATE_LIMIT_PER_DAY=1000

# CORS
ALLOWED_ORIGINS=*

# OAuth Providers
OAUTH_PROVIDERS=openrouter,github,google

# Logging
LOG_LEVEL=INFO
