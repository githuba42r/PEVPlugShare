# Docker-specific environment file
# Copy this to .env and customize for your deployment

# Database (Docker volume path)
DATABASE_URL=sqlite:////app/data/oauth_sessions.db

# Session Settings
SESSION_TTL_MINUTES=10
CLEANUP_INTERVAL_MINUTES=5

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100
RATE_LIMIT_PER_DAY=1000

# CORS
ALLOWED_ORIGINS=*

# OAuth Providers
OAUTH_PROVIDERS=openrouter,github,google

# Logging
LOG_LEVEL=INFO

# Cloudflare Tunnel (Optional)
CLOUDFLARE_TUNNEL_ENABLED=false
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Applications are configured in the database, NOT environment variables.
# On first startup, a sample application 'pevplugshare' is created.
#
# To configure your application:
# 1. Start the container: docker-compose up -d
# 2. Access database: docker exec -it oauth-callback-service sqlite3 /app/data/oauth_sessions.db
# 3. Update the sample app:
#    UPDATE applications
#    SET allowed_domains = 'your-domain.com',
#        shared_secret = 'your-generated-secret'
#    WHERE app_id = 'pevplugshare';
#
# Generate secure secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================================
