# OAuth Callback Service Configuration

# Service Settings
HOST=0.0.0.0
PORT=8000

# Cloudflare Tunnel (Optional)
# Set to true to enable Cloudflare Tunnel for public HTTPS access
CLOUDFLARE_TUNNEL_ENABLED=false
# Get your tunnel token from: https://one.dash.cloudflare.com/ -> Zero Trust -> Networks -> Tunnels
# Create a tunnel, configure a public hostname, then copy the token
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# Database
DATABASE_URL=sqlite:///./oauth_sessions.db

# Session Settings
SESSION_TTL_MINUTES=10
CLEANUP_INTERVAL_MINUTES=5

# Rate Limiting (per IP address)
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100
RATE_LIMIT_PER_DAY=1000

# CORS Settings (comma-separated list of allowed origins)
ALLOWED_ORIGINS=*
# For production: ALLOWED_ORIGINS=https://openrouter.ai,https://example.com

# OAuth Provider Settings (generic multi-provider support)
# Format: PROVIDER_NAME=callback_param_name
# Example: OPENROUTER=code,GITHUB=code,GOOGLE=code
OAUTH_PROVIDERS=openrouter,github,google

# Logging
LOG_LEVEL=INFO

# Diagnostic Endpoints (Testing/Debugging)
# Set to true to enable /ping and /version endpoints
# These are rate-limited to 5 requests per minute per IP
# WARNING: Only enable in development/testing environments
ENABLE_DIAGNOSTIC_ENDPOINTS=false

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Applications are now configured in the database (applications table)
# On first startup, a sample application is created:
#
# App ID: pevplugshare
# Allowed Domains: pevplugshare.a42r.com,pevplugshare-prod.a42r.com,localhost:8000
# Deep Link: pevplugshare://oauth/callback
# Secret: CHANGE_THIS_SECRET (MUST be changed in production!)
#
# To add more applications:
# 1. Connect to database: sqlite3 oauth_sessions.db
# 2. Insert application:
#    INSERT INTO applications (app_id, name, allowed_domains, deep_link_scheme, shared_secret, is_active)
#    VALUES ('your-app', 'Your App Name', 'yourdomain.com', 'yourapp://oauth/callback', 'your-secret', 1);
# 3. Generate secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Each application validates:
# - Request must come from an allowed domain
# - Signature must match using the application's shared secret
# - Deep link must match the registered scheme
# ============================================================================

