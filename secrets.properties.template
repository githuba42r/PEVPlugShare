# OAuth Secrets Configuration Template
#
# IMPORTANT: Copy this file to secrets.properties and fill in your actual secrets.
# DO NOT commit secrets.properties to git - it is in .gitignore
#
# To use this template:
# 1. Copy this file: cp secrets.properties.template secrets.properties
# 2. Fill in the actual values below
# 3. Never commit secrets.properties to version control

# Development secrets
# These are used when building debug builds of the app
oauth.dev.callback.url=https://oauth.a42r.com
oauth.dev.shared.secret=your-development-env-secret-here
oauth.dev.deep.link.scheme=pevplugshare://oauth/callback

# Production secrets
# These are used when building release builds of the app
oauth.prod.callback.url=https://oauth.a42r.com
oauth.prod.shared.secret=your-production-secret-here
oauth.prod.deep.link.scheme=pevplugshare://oauth/callback
